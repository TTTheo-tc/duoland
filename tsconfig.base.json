{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@sel-quest/quest-core": ["packages/quest-core/src/index.ts"],
      "@sel-quest/content": ["packages/content/src/index.ts"],
      "@sel-quest/activities": ["packages/activities/src/index.ts"],
      "@sel-quest/persistence": ["packages/persistence/src/index.ts"],
      "@sel-quest/game-runtime": ["packages/game-runtime/src/index.ts"],
      "@sel-quest/safety": ["packages/safety/src/index.ts"],
      "@sel-quest/ai-runtime": ["packages/ai-runtime/src/index.ts"]
    }
  }
}
